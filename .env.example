# Bureau of Indian Standards (BIS) AI Assistant - Environment Template
# Copy this file to .env and insert your API key(s)

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Local Ollama Host (Optional)
OLLAMA_HOST=http://localhost:11434

# PostgreSQL Database URL for Permanent Cloud Storage (Render PostgreSQL / Supabase / Neon)
# e.g., postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

